# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0

# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://savyant_app:CHANGE_ME@127.0.0.1:3306/savyant_db?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://savyant_app:CHANGE_ME@127.0.0.1:3306/savyant_test?charset=utf8mb4

# Passwords for the sample accounts created by `flask seed`.
# These are demo-only values for local use. Pick your own.
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SALES_PASSWORD=Sales@12345
